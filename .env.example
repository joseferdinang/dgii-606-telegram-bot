TELEGRAM_BOT_TOKEN=replace-with-botfather-token
GOOGLE_VISION_CREDENTIALS=/run/secrets/google-vision.json

# Optional: DGII Reporting RNC (requerido para generar el archivo oficial TXT y para NCF B17)
DGII_REPORTING_RNC=

# OpenAI ChatGPT API para extracción inteligente de facturas (opcional pero recomendado)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Local defaults. Docker Compose overrides these with /app/data paths.
APP_DATA_DIR=data
STATE_DB_PATH=data/state/bot606.sqlite3
EXPORT_DIRECTORY=data/exports
