# Token del bot de Telegram proporcionado por @BotFather (Obligatorio)
TELEGRAM_BOT_TOKEN=replace-with-botfather-token

# Extractor Inteligente con OpenAI ChatGPT (Recomendado)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna

# Google Cloud Vision OCR (Opcional si usas OpenAI)
# Si lo usas, coloca el archivo JSON en credentials/google-vision.json y descomenta:
# GOOGLE_VISION_CREDENTIALS=/app/credentials/google-vision.json

# DGII RNC por defecto (Opcional, las empresas pueden registrarse con /registro y /login)
DGII_REPORTING_RNC=

# Directorios de datos (Docker Compose utiliza las rutas persistentes /app/data)
APP_DATA_DIR=data
STATE_DB_PATH=data/state/bot606.sqlite3
EXPORT_DIRECTORY=data/exports
